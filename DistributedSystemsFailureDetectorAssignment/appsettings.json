{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  // Node send its heartbeat every X miliseconds by default
  "HeartbeatPropagationIntervalMs": 5000,
  // The failure detector service checks for suspected nodes every X miliseconds
  "FailureDetectorCheckingIntervalMs": 7000,
  "Cluster": {
    // The default time interval up to which a should be considered suspected
    "DefaultNodeElapsedTimeThresholdMilliseconds": 5000,
    // Expecting to play with 3 nodes. Including as a neighbour the "current" will make it receive its own messages
    "Nodes": [
      {
        "NodeUrl": "http://localhost:5000"
      },
      {
        "NodeUrl": "http://localhost:5001"
      },
      {
        "NodeUrl": "http://localhost:5002"
      }
    ]
  }
}
